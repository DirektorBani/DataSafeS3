{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DataSafeS3 Desktop",
  "version": "1.0.0-dev",
  "identifier": "com.datasafe.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "DataSafeS3 Desktop",
        "width": 960,
        "height": 640,
        "resizable": true,
        "generalAutofillEnabled": false,
        "additionalBrowserArgs": "--disable-background-networking --disable-component-update --disable-domain-reliability --disable-sync --disable-client-side-phishing-detection --no-pings --disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection,ComponentUpdater,AutofillServerCommunication,OptimizationHints,Translate,Autofill,PasswordManager,PasswordManagerOnboarding"
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self'; style-src 'self'; script-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "resources": {
      "binaries/": "binaries/"
    },
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser",
        "installerHooks": "windows/installer-hooks.nsh"
      },
      "signCommand": {
        "cmd": "powershell.exe",
        "args": [
          "-NoProfile",
          "-ExecutionPolicy",
          "Bypass",
          "-File",
          "windows/sign-test.ps1",
          "%1"
        ]
      }
    }
  }
}
