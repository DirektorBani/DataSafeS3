# Erasure backend lab — alternate ports from main `datasafe` dev stack.
DATASAFE_DATA_ROOT=D:/datasafe-data-erasure
STORAGE_METADATA_BACKEND=postgres
PUBLIC_HTTP_PORT=8082
HA_PRIMARY_STORAGE_PORT=9002
STORAGE_POSTGRES_PUBLISH_PORT=5442
STORAGE_DEV=true
STORAGE_OBJECT_BACKEND=erasure
STORAGE_ERASURE_LAYOUT=dev
STORAGE_RATE_LIMIT_LOGIN=500
