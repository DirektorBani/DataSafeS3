# Copy to .env and replace every value. Do not commit .env.
# STORAGE_DEV is not read from this file. The compose file sets it to false.

STORAGE_REGION=us-east-1
STORAGE_ACCESS_KEY=replace-me
STORAGE_SECRET_KEY=replace-me-long-secret
STORAGE_ADMIN_USER=admin
STORAGE_ADMIN_PASSWORD=replace-me-admin-password
STORAGE_JWT_SECRET=replace-me-jwt-secret
STORAGE_METRICS_TOKEN=replace-me-metrics-token

# Optional SSE-S3 key. Leave empty to keep new objects plaintext.
STORAGE_SSE_MASTER_KEY=

# Published images. The release pin matches VERSION.
# DATASAFE_SERVER_IMAGE=gitverse.ru/direktorbani/datasafe-storage-server:v1.7.0
# DATASAFE_CONSOLE_IMAGE=gitverse.ru/direktorbani/datasafe-console:v1.7.0

PUBLIC_HTTP_PORT=8080
PUBLIC_HTTPS_PORT=8443
# S3 on the host loopback only. The public path is Caddy.
S3_BIND_PORT=9000
