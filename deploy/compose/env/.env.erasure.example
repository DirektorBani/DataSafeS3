# Erasure backend lab. Ports stay off the main stack (:8080/:9000/:5432),
# the HA lab (:8082/:9002/:5442), and the vault stand (:9001/:5434/:8200).
# Delete an older .env.erasure and re-run the start script to pick these up.
DATASAFE_DATA_ROOT=D:/datasafe-data-erasure
STORAGE_METADATA_BACKEND=postgres
PUBLIC_HTTP_PORT=8084
ERASURE_STORAGE_PORT=9004
STORAGE_POSTGRES_PUBLISH_PORT=5444
PROMETHEUS_PORT=9094
GRAFANA_PORT=3004
STORAGE_DEV=true
STORAGE_OBJECT_BACKEND=erasure
STORAGE_ERASURE_LAYOUT=dev
STORAGE_RATE_LIMIT_LOGIN=500
