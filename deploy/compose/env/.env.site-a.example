# Source site for the site-replication lab (stack A).
# Ports stay off the main stack, the HA lab, the erasure lab, and the vault stand.
# Delete an older .env.site-a and re-run the start script to pick these up.
DATASAFE_DATA_ROOT=D:/datasafe-data-site-a
STORAGE_METADATA_BACKEND=postgres
PUBLIC_HTTP_PORT=8086
SITE_A_STORAGE_PORT=9006
STORAGE_POSTGRES_PUBLISH_PORT=5446
PROMETHEUS_PORT=9096
GRAFANA_PORT=3006
STORAGE_DEV=true
STORAGE_SITE_REPLICATION_ENABLED=true
STORAGE_SITE_REPL_WORKER_INTERVAL=2s
STORAGE_CLUSTER_ENDPOINT=http://host.docker.internal:9006
STORAGE_RATE_LIMIT_LOGIN=500
