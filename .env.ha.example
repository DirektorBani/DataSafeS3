# HA lab stack — alternate ports so main `datasafe` dev stack can stay up.
DATASAFE_DATA_ROOT=D:/datasafe-data-ha
STORAGE_METADATA_BACKEND=postgres
PUBLIC_HTTP_PORT=8082
HA_PRIMARY_STORAGE_PORT=9002
HA_STANDBY_HTTP_PORT=9001
HA_STANDBY2_HTTP_PORT=9003
HA_OBJECT_SYNC_INTERVAL_SEC=3
PROMETHEUS_PORT=9092
GRAFANA_PORT=3002
STORAGE_POSTGRES_PUBLISH_PORT=5442
STORAGE_POSTGRES_STANDBY_PORT=5443
STORAGE_DEV=true
STORAGE_RATE_LIMIT_LOGIN=500
