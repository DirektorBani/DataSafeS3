[Unit]
Description=DataSafeS3 storage server
Documentation=https://gitverse.ru/DirektorBani/DataSafeS3
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=datasafes3
Group=datasafes3
WorkingDirectory=/var/lib/datasafes3
EnvironmentFile=/etc/datasafes3/datasafes3.env
ExecStart=/usr/bin/datasafe-storage-server
Restart=on-failure
RestartSec=5s
LimitNOFILE=65536
UMask=0027
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/datasafes3
StateDirectory=datasafes3
StateDirectoryMode=0750
LockPersonality=true
RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target
