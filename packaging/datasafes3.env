# DataSafeS3 storage server.
# This file is a package config file. Upgrades keep your edits.
# The package does not start the service. Replace the historical default
# secrets below, then run: systemctl enable --now datasafes3
#
# STORAGE_STRICT_SECRETS=true refuses to start while STORAGE_ADMIN_PASSWORD,
# STORAGE_SECRET_KEY, or STORAGE_JWT_SECRET is still a historical default.

STORAGE_ADDR=:9000
STORAGE_LOG_LEVEL=info
STORAGE_DATA_DIR=/var/lib/datasafes3
STORAGE_REGION=us-east-1
STORAGE_METADATA_BACKEND=bolt
STORAGE_DEV=false
STORAGE_STRICT_SECRETS=true
STORAGE_ADMIN_USER=admin
STORAGE_ADMIN_PASSWORD=admin
STORAGE_ACCESS_KEY=datasafe
STORAGE_SECRET_KEY=datasafesecret
STORAGE_JWT_SECRET=datasafe-jwt-secret
